PORT=4000
JWT_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_API_URL=http://localhost:4000
# Optional: enables server-side LLM enrichment. The deterministic fallback works without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
# Optional MongoDB Atlas URI. Without it, local development uses data/store.json.
# Leave empty for local development. For deployment, use your real Atlas URI:
# mongodb+srv://<user>:<password>@<cluster>/trao_prep?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=trao_prep
